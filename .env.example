# Provider configuration (credentials are required only for live application runs)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_BASE_URL=
TAVILY_API_KEY=
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Server-owned hard research budgets
MAX_INITIAL_TASKS=5
MAX_SUPERVISOR_TASKS=2
MAX_REVIEWER_TASKS=1
MAX_RESEARCH_ROUNDS=2
MAX_QUERIES_PER_ROUND=2
MAX_CONCURRENT_RESEARCHERS=3
MAX_TOTAL_SEARCH_QUERIES=20
MAX_SOURCES_PER_TASK=8
MAX_EVIDENCE_PER_TASK=20

# Optional literature RAG (Qdrant is the only RAG data store)
RAG_ENABLED=false

# Qdrant Cloud (recommended): https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=research_literature
# DashScope text-embedding-v3 supports 1024, 768, 512, 256, 128, or 64.
# Use 384 with the default local MiniLM model.
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=cosine
QDRANT_TIMEOUT=30

# Embedding service: dashscope (recommended) or local
# DashScope API key: https://dashscope.aliyun.com/
# Empty model name selects text-embedding-v3 for dashscope and
# sentence-transformers/all-MiniLM-L6-v2 for local.
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=
EMBED_API_KEY=
EMBED_BASE_URL=

# Docling chunk tokenizer and local reranker
RAG_CHUNK_TOKENIZER_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_CHUNK_MAX_TOKENS=800
RAG_CANDIDATE_LIMIT=30
RAG_TOP_K=8
RAG_CONTEXT_MAX_CHARS=20000
RAG_MAX_UPLOAD_BYTES=52428800

# Single-owner authentication
APP_BASE_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7
AUTH_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900