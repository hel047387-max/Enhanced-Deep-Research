{$APP_DOMAIN} {
    request_body {
        max_size 50MiB
    }

    handle /api/* {
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }

    handle /health {
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}